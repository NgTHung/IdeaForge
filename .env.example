# Server-only. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Configurable model: choose one available to your API project.
GEMINI_MODEL=gemini-2.5-flash
# Optional generation fallback, called after two overload or timeout failures.
GEMINI_FALLBACK_MODEL=
# Embedding fallbacks must be embedding models, not generation models.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_FALLBACK_MODEL=
# Boards with fewer cards use nearest-neighbor ranks instead of centered cosine.
SIMILARITY_MIN_CENTERED_CARDS=8

# Server-only. Enables guest collaboration at /board/<uuid>.
# Get a secret key from https://liveblocks.io/dashboard
LIVEBLOCKS_SECRET_KEY=
