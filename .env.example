# Server-only. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Configurable model: choose one available to your API project.
GEMINI_MODEL=gemini-2.5-flash
# Optional generation fallback, called after two overload or timeout failures.
GEMINI_FALLBACK_MODEL=
# Embedding fallbacks must be embedding models, not generation models.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_FALLBACK_MODEL=
# Boards with fewer cards use nearest-neighbor ranks instead of centered cosine.
SIMILARITY_MIN_CENTERED_CARDS=8

# Server-only. Enables guest collaboration at /board/<uuid>.
# Get a secret key from https://liveblocks.io/dashboard
LIVEBLOCKS_SECRET_KEY=

# Include the Atlas username and password in the URI. URL-encode special characters.
MONGODB_URI=
MONGODB_DB_NAME=ideaforge_dev

# Express API and Better Auth. Keep these values in .env, never in the browser.
API_PORT=4000
API_ORIGIN=http://localhost:4000
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP is required to verify email/password accounts and reset passwords.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
