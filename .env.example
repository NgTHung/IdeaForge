# Server-only. Generation (merges, group names, explanations) uses Featherless.
# Get a key at https://featherless.ai/account/api-keys
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=zai-org/GLM-5.3-Flash
# Optional generation fallback, called after two overload or timeout failures.
FEATHERLESS_FALLBACK_MODEL=
# GLM accepts low, high, or max. Higher effort is slower and can hit the 30-second attempt timeout.
FEATHERLESS_REASONING_EFFORT=low

# Server-only. Embeddings use Gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Embedding fallbacks must be embedding models, not generation models.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_FALLBACK_MODEL=
# Boards with fewer cards use nearest-neighbor ranks instead of centered cosine.
SIMILARITY_MIN_CENTERED_CARDS=8

# Automatic relationships use local matching and TypeSafe Jev, never the generation model.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# Global daily request allowances for relationships only; 0 disables new calls.
# MongoDB stores cache entries and atomic counters across server workers.
CONNECTION_JEV_DAILY_REQUEST_LIMIT=200
CONNECTION_EXPLANATION_DAILY_REQUEST_LIMIT=20

# Server-only. Enables guest collaboration at /board/<uuid>.
# Get a secret key from https://liveblocks.io/dashboard
LIVEBLOCKS_SECRET_KEY=

# Include the Atlas username and password in the URI. URL-encode special characters.
MONGODB_URI=
MONGODB_DB_NAME=ideaforge_dev

# Express API and Better Auth. Keep these values in .env, never in the browser.
API_PORT=4000
API_ORIGIN=http://localhost:4000
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP is required to verify email/password accounts and reset passwords.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
